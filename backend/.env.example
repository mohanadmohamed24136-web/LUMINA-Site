# --- LUMINA PRODUCTION ENVIRONMENT TEMPLATE ---

# 1. Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=your_db_password
DB_NAME=lumina_db

# 2. Server Configuration
PORT=3000
FRONTEND_URL=http://your-domain.com

# 3. Email Configuration (SMTP)
# For Gmail: Use App Passwords, not your regular password.
EMAIL_USER=lumina.future.ai@gmail.com
EMAIL_PASS=your_app_password

# 4. Stripe Payment Gateway
# Get these from your Stripe Dashboard (Developers > API Keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# 5. Security
# Change this to a long random string for production
JWT_SECRET=your_super_secret_neural_key

# 6. Cloudinary Configuration (Required for Vercel/Production)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
